---
import EyeIcon from "./icons/Eye.astro";
const { id, title, image, description, date, cargo, privacy, link } =
    Astro.props;
---

<li>
    <div
        class="block py-4 sm:py-5 px-4 sm:px-7 rounded-lg transition-all duration-200 ease-in-out"
    >
        <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
            <!-- Logo -->
            <img
                class="w-16 h-16 sm:w-24 sm:h-24 rounded-full mx-auto sm:mx-0"
                src={image}
                alt={`Logo de ${title}`}
            />
            <!-- Contenido -->
            <div class="w-full">
                <div
                    class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:mb-2"
                >
                    <h3
                        class="text-xl sm:text-2xl font-bold text-[#00c3f2] text-center sm:text-left"
                    >
                        {title}
                    </h3>
                    <p
                        class="flex items-center justify-center sm:justify-start gap-2 text-sm text-white max-sm:hidden"
                    >
                        <EyeIcon class="w-4 h-4" />
                        {privacy}
                    </p>
                </div>
                <p
                    class="text-base sm:text-lg text-white text-center sm:text-left max-sm:mt-2"
                >
                    {id}. {cargo}
                </p>
                <p
                    class="text-base sm:text-lg mt-2 mb-3 sm:mb-4 text-white opacity-50 sm:text-left max-sm:text-pretty"
                >
                    {description}
                </p>
                <div
                    class="flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-0"
                >
                    <span class="text-sm text-white">{date}</span>
                    <a
                        href={link}
                        target="_blank"
                        class="text-sm text-black bg-[#00c3f2] py-1 px-3 rounded-full hover:text-white hover:border-white border-[#00c3f2] border-2 hover:bg-transparent transition-all duration-300 ease-in-out w-full sm:w-auto text-center font-semibold"
                    >
                        Ver empresa ➜
                    </a>
                </div>
            </div>
        </div>
    </div>
</li>
