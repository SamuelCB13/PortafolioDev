---
import Angular from "./icons/Angular.astro";
import AstroIcon from "./icons/AstroI.astro";
import Tailwind from "./icons/TailwindCss.astro";
import Nodejs from "./icons/Nodejs.astro";
import Sql from "./icons/Sql.astro";
import Github from "./icons/Github.astro";
import ViewProject from "./icons/ViewProject.astro";
import Nextjs from "./icons/Nextjs.astro";
import Nextauth from "./icons/Nextauth.astro";
import Toast from "./icons/Toast.astro";

const TAGS = {
    ANGULAR: {
        name: "Angular",
        class: "border border-[#d13438] text-white",
        icon: Angular,
    },
    NEXTJS: {
        name: "Next.js",
        class: "border border-white text-white",
        icon: Nextjs,
    },
    NEXTAUTH: {
        name: "NextAuth",
        class: "border border-purple-500 text-white",
        icon: Nextauth,
    },
    ASTRO: {
        name: "Astro",
        class: "border border-[#ff7e00] text-white",
        icon: AstroIcon,
    },
    TAILWIND: {
        name: "TailwindCss",
        class: "border border-[#2298BD] text-white",
        icon: Tailwind,
    },
    NODEJS: {
        name: "Node.js",
        class: "border border-[#3c873a] text-white",
        icon: Nodejs,
    },
    SQL: {
        name: "Sql",
        class: "border border-[#2298BD] text-white",
        icon: Sql,
    },
    TOAST: {
        name: "Toast",
        class: "border border-white text-white",
        icon: Toast,
    },
};

const PROJECTS = [
    {
        title: "Sanación Angelical - Angeóloga y Terapeuta Emocional con +15 Años de Experiencia",
        description:
            "Landing page para cliente con información sobre lo que hace, los servicios que ofrece, información sobre la angeóloga, testimonios de clientes y diferentes formas de contacto. Creada con Astro y Tailwind CSS.",
        link: "https://sanacion-angelical.vercel.app/",
        github: "https://github.com/SamuelCB13/SanacionAngelical.git",
        image: "/proyecto2.webp",
        tags: [TAGS.ASTRO, TAGS.TAILWIND],
    },
    {
        title: "Intranet Corporativa | Red social para empleados activos en la empresa",
        description:
            "Intranet Corporativa para mantener al tanto de todo a los empleados activos de la empresa con una red social interna. Creada con Nextjs y Tailwind CSS.",
        link: "https://intranet-corporativa.vercel.app/",
        github: "https://github.com/SamuelCB13/IntranetCorporativa.git",
        image: "/proyecto3.webp",
        tags: [TAGS.NEXTJS, TAGS.NEXTAUTH, TAGS.TAILWIND],
    },
    {
        title: "Generador de Contraseñas | Generador y verificador de contraseñas seguras",
        description:
            "Generador de Contraseñas para generar y verificar la seguridad de tus contraseñas. Creada con Nextjs y Tailwind CSS.",
        link: "https://generador-contrasenas-sc.vercel.app/",
        github: "https://github.com/SamuelCB13/GeneradorContrasenas.git",
        image: "/proyecto4.webp",
        tags: [TAGS.NEXTJS, TAGS.TAILWIND, TAGS.TOAST],
    },
];
---

<main class="flex items-center justify-center pt-8 sm:pt-16" id="proyectos">
    <div
        class="relative w-full h-full flex flex-col items-center justify-center px-4 sm:px-6 md:px-8"
    >
        <!-- Texto de fondo -->
        <h1
            class="absolute -top-4 sm:top-14 text-6xl sm:text-8xl md:text-[12rem] lg:text-[15rem] font-extrabold text-gray-200 uppercase opacity-[0.07] select-none text-center w-full"
        >
            Proyectos
        </h1>

        <!-- Contenido principal -->
        <div
            class="flex flex-col gap-y-8 sm:gap-y-16 mt-20 sm:mt-24 md:mt-32 lg:mt-52 w-full"
        >
            {
                PROJECTS.map(
                    ({ image, title, description, tags, link, github }) => (
                        <article class="flex flex-col md:flex-row items-center justify-center gap-6 md:space-x-8 group max-w-5xl mx-auto max-sm:px-3">
                            <div class="w-full md:w-1/2 max-w-xl">
                                <div class="relative flex flex-col items-center gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl group-hover:shadow-2xl border border-gray-800 hover:border-gray-700 hover:scale-105">
                                    <img
                                        alt="Captura del proyecto"
                                        class="w-full aspect-16/10 object-cover transition duration-500"
                                        loading="lazy"
                                        src={image}
                                    />
                                </div>
                            </div>

                            <div class="w-full md:w-1/2 max-w-md">
                                <h3 class="text-xl sm:text-2xl font-bold text-gray-800 dark:text-white text-center md:text-left">
                                    {title}
                                </h3>
                                <div class="flex flex-wrap mt-2 max-sm:justify-center">
                                    <ul class="flex flex-row flex-wrap justify-center md:justify-start mb-2 gap-2 max-sm:mt-2">
                                        {tags.map((tag) => (
                                            <li>
                                                <span
                                                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-3 backdrop-blur-xl bg-opacity-75`}
                                                >
                                                    <tag.icon class="size-4" />
                                                    {tag.name}
                                                </span>
                                            </li>
                                        ))}
                                    </ul>

                                    <div class="mt-2 text-gray-700 dark:text-gray-400 text-center md:text-left max-sm:text-start">
                                        {description}
                                    </div>
                                    <footer class="flex items-center justify-center md:justify-start w-full mt-4 gap-x-4">
                                        {link && (
                                            <a
                                                href={link}
                                                target="_blank"
                                                class="px-4 py-1 rounded-full shadow-md text-black font-semibold border-2 bg-[#00c3f2] border-[#00c3f2] hover:bg-transparent hover:text-white hover:border-white flex items-center gap-1 transition-all duration-300 ease-in-out text-sm sm:text-base"
                                            >
                                                <ViewProject class="size-4 sm:size-5" />
                                                Preview
                                            </a>
                                        )}
                                        {github && (
                                            <a
                                                href={github}
                                                target="_blank"
                                                class="px-4 py-1 rounded-full shadow-md text-black border-2 bg-white border-white hover:text-white hover:bg-transparent hover:border-white flex items-center gap-1 transition-all duration-300 ease-in-out font-semibold text-sm sm:text-base"
                                            >
                                                <Github class="size-4 sm:size-5" />
                                                GitHub
                                            </a>
                                        )}
                                    </footer>
                                </div>
                            </div>
                        </article>
                    ),
                )
            }
        </div>
    </div>
</main>

<style>
    main {
        animation: slideUp 0.5s ease-out;
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
