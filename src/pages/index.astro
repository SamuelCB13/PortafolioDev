---
// Importe de la tipografía Fjalla One
import "@fontsource/fjalla-one";

// Importes generales
import Layout from "../layouts/Layout.astro";
import Experiencia from "../components/Experiencia.astro";
import Inicio from "../components/Inicio.astro";
import Proyectos from "../components/Proyectos.astro";
import SobreMi from "../components/SobreMi.astro";
import Contacto from "../components/Contacto.astro";
---

<Layout>
    <!-- Sección de inicio -->
    <Inicio />

    <!-- Sección de experiencia -->
    <Experiencia />

    <!-- Sección de proyectos -->
    <Proyectos />

    <!-- Sección de sobre mí -->
    <SobreMi />

    <!-- Sección de contacto -->
    <Contacto />
</Layout>

<style>
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: "Fjalla One", sans-serif;
    }
</style>