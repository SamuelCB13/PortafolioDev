---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Personal - Desarrollador con +1 año de experiencia</title>
	</head>
	<body>
		<div class="fixed top-0 left-0 w-full h-full -z-50 bg-black bg-[radial-gradient(#545454,transparent_1px)] [background-size:16px_16px]"></div>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
        font-family: 'Rubik Variable', sans-serif;
		color: #585454;
	}

	/* Scroll animado al dar clic a un <a> para ir a una sección */
	html {
		scroll-behavior: smooth;
	}

	/* No hacer animación de scroll si el usuario tiene las animaciones desactivadas */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
