---
import "../styles/global.css";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Personal - Desarrollador con +1 año de experiencia</title>
	</head>
	<body>
		<div class="fixed top-0 left-0 w-full h-full -z-50 bg-black bg-[radial-gradient(#545454,transparent_1px)] bg-size-[16px_16px]"></div>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
